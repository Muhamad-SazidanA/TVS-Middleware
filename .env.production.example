# ==============================================================================
# DocMatch Production Environment Template (docmatch.solusiaplikasi.id)
# Salin menjadi .env di /root/docmatch/.env dan isi semua secret dengan aman.
# ==============================================================================

NODE_ENV="production"

# Port host lokal di belakang Nginx (jangan 3000 agar tidak bentrok dengan app lain)
DOCMATCH_PORT="3100"

# NextAuth v5 Configuration
# Generate secret baru di VPS: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
AUTH_URL="https://docmatch.solusiaplikasi.id"
AUTH_TRUST_HOST="true"

# MySQL Credentials (untuk docker-compose.yml service docmatch-db)
MYSQL_ROOT_PASSWORD="CHANGE_ME_STRONG_ROOT_PASSWORD"
MYSQL_DATABASE="docmatch"
MYSQL_USER="docmatch"
MYSQL_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"

# Prisma Database URL
# - Jika pakai Docker Compose (default): host harus "docmatch-db"
# - Jika pakai MySQL host langsung (PM2 mode): ganti host jadi "127.0.0.1"
DATABASE_URL="mysql://docmatch:CHANGE_ME_STRONG_DB_PASSWORD@docmatch-db:3306/docmatch"

# Nanonets OCR API Key
NANONETS_API_KEY="YOUR_NANONETS_API_KEY"
# Opsional alias jika dipakai modul tertentu:
API_KEY="YOUR_NANONETS_API_KEY"

# Opsional: Nanonets Model ID Overrides (jika kosong akan memakai default di sistem)
# MODEL_PIB=""
# MODEL_INVOICE=""
# MODEL_BL=""
# MODEL_PACKING_LIST=""
# MODEL_AK=""
# MODEL_WL=""
# MODEL_MS=""
