generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
  @@map("post")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            String    @default("STAFF") // "STAFF" | "APPROVER" | "ADMIN"
  accounts        Account[]
  sessions        Session[]
  posts           Post[]
  batches         Batch[]   @relation("CreatedBatches")
  approvedBatches Batch[]   @relation("ApprovedBatches")

  @@map("user")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model Batch {
  id           String        @id
  totalFile    Int           @default(0)
  status       String        @default("PENDING") // "DRAFT" | "PENDING" | "MATCHING" | "MISMATCHING" | "APPROVED" | "DITOLAK"
  errorMessage String?       @db.Text
  createdById  String?
  createdBy    User?         @relation("CreatedBatches", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   User?         @relation("ApprovedBatches", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  details      DetailBatch[]
  logs         BatchLog[]
  actionLogs   ActionLog[]

  @@index([createdById])
  @@index([approvedById])
  @@map("batches")
}

model ActionLog {
  id        Int      @id @default(autoincrement())
  batchId   String
  docType   String?
  docNumber String?
  fieldName String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  notes     String?  @db.Text
  actionBy  String?
  createdAt DateTime @default(now())

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("action_logs")
}

model DetailBatch {
  id           Int      @id @default(autoincrement())
  batchId      String
  fileType     String
  fileId       String
  nomorAju     String?
  nomorInvoice String?
  isi          String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("detail_batches")
}

model BatchLog {
  id         Int      @id @default(autoincrement())
  batchId    String
  step       String
  stepNumber Int      @default(1)
  level      String   @default("INFO")
  title      String
  message    String   @db.Text
  fileType   String?
  fileName   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("batch_logs")
}

model EquivalencyGroup {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("general")
  canonical String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  values    EquivalencyValue[]

  @@map("equivalency_groups")
}

model EquivalencyValue {
  id      Int              @id @default(autoincrement())
  value   String           @db.Text
  groupId Int
  group   EquivalencyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("equivalency_values")
}

model SystemAuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  userName  String?
  userEmail String?
  action    String   // CREATE, UPDATE, DELETE, OVERRIDE
  category  String   // DATA_ACTION, EQUIVALENCY, BATCH_DATA, SYSTEM_SETTING
  title     String
  details   String?  @db.Text
  metadata  String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@map("system_audit_logs")
}
